    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "data = np.loadtxt(\"inter_arrival.txt\")\n",
    "\n",
    "plt.hist(data, bins=50, density=True)\n",
    "t = np.linspace(0, max(data), 100)\n",
    "plt.plot(t, 10*np.exp(-10*t), 'r')\n",
    "plt.show()\n"
   ]
  }
