clear;
clc;
close all;

T = 300;
mu = 50; %  service rate
% K = 100; % buffer size
K = [50, 100, 200];

cwnd = 1; % congestion window
q = 0;  % queue size
 
cwnd_trace = zeros(1, T);
q_trace =  zeros(1, T);
drop_trace = zeros(1, T);
for K = [50, 100, 200]
    for t = 1:T
        arrivals = max(cwnd,0);
        q = q+arrivals;
        
        served = min(q, mu);
        q = q - served;
    
        if q > K
            drops = q - K; % packets dropped
            q = K;
        else
            drops = 0;
        end;
        
    
        loss_event = (drops > 0);
    
        % baseline, no congestion control
        cwnd = cwnd + 1;
    
        cwnd = max(cwnd, 1);
    
        cwnd_trace(t) = cwnd;
        q_trace(t) = q;
        drop_trace(t) = drops;
        
    end
end


